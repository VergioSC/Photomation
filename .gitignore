# Python virtual environment
.venv/

# Photos: never commit image data (keeps the repo small)
input/
output/

# LUT files: often large and third-party licensed. Keep the folder, not
# its contents.
luts/*.cube
!luts/.gitkeep

# Thumbnail cache generated by the web app
.cache/

# Python bytecode cache
__pycache__/
*.pyc

# macOS Finder metadata
.DS_Store
